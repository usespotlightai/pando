# Each job writes its own region of the device and checks every block (crc32c).
# verify_backlog re-reads blocks soon after they are written, while their 64 KiB chunk
# still holds older data around them.
[global]
ioengine=libaio
direct=1
filename=${DEV}
verify=crc32c
verify_backlog=512
verify_fatal=1
do_verify=1
randrepeat=1
group_reporting=0
stonewall

[rand4k]
rw=randwrite
bs=4k
iodepth=32
numjobs=4
size=64M
offset=0
offset_increment=64M

[mixed]
rw=randwrite
bsrange=4k-1m
blockalign=4k
iodepth=16
size=256M
offset=256M

[seq1m]
rw=write
bs=1m
iodepth=8
size=256M
offset=512M

[base64k]
rw=write
bs=64k
iodepth=8
size=128M
offset=768M
do_verify=0
verify=0

[over4k]
rw=randwrite
bs=4k
iodepth=32
size=128M
offset=768M

[fua]
rw=randwrite
bs=16k
sync=1
iodepth=8
size=64M
offset=896M

[flush]
rw=randwrite
bs=64k
fsync=32
iodepth=1
size=64M
offset=960M
